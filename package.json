{
  "name": "qa-interview-hub",
  "private": true,
  "version": "0.1.0",
  "description": "QA Interview Hub: quizzes, active recall and a knowledge base with accounts, levels and daily tasks.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content:extract": "tsx packages/content/scripts/extract.ts",
    "content:check-en": "tsx packages/content/scripts/check-translation.ts",
    "db:start": "npm run db:start -w @qa-hub/api",
    "db:migrate": "npm run db:migrate -w @qa-hub/api",
    "db:seed": "npm run db:seed -w @qa-hub/api",
    "dev:api": "npm run dev -w @qa-hub/api",
    "dev:web": "npm run dev -w @qa-hub/web",
    "build": "npm run build -w @qa-hub/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "@prisma/engines@6.19.3": true
  }
}
