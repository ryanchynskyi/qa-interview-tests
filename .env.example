# Copy to apps/api/.env and adjust.
# Default matches `npm run db:start` (embedded Postgres) and docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qahub

PORT=3000
WEB_ORIGIN=http://localhost:5173

# 127.0.0.1 by default; use 0.0.0.0 inside containers
# HOST=127.0.0.1

# Integration tests: a separate database, created, migrated and seeded automatically.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qahub_test

# Access-token signing key, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# true in production (HTTPS-only refresh cookie); defaults from NODE_ENV
# COOKIE_SECURE=false
# "none" when the web app is on another site than the API (GitHub Pages + hosted API):
# SameSite=None; Secure; Partitioned refresh cookie. Needs COOKIE_SECURE=true.
# COOKIE_SAMESITE=lax
# Behind a hosting proxy: proxy hops to trust in X-Forwarded-For (for per-IP rate limits)
# TRUST_PROXY=false

# Google sign-in (optional; all three or none). See README for the console setup.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Full URL of the web app if not WEB_ORIGIN + "/" (e.g. a GitHub Pages path)
# WEB_APP_URL=http://localhost:5173/
