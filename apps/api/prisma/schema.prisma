// Content tables are filled by `npm run db:seed` from packages/content/data.
// Users, progress and gamification tables arrive in later milestones (M4+).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Level {
  junior
  middle
  senior
}

model Topic {
  id          String       @id
  name        String
  order       Int
  sections    Section[]
  chapters    Chapter[]
  recallCards RecallCard[]
}

model Section {
  id          String     @id
  topicId     String
  name        String
  description String
  order       Int
  topic       Topic      @relation(fields: [topicId], references: [id])
  questions   Question[]

  @@index([topicId])
}

model Chapter {
  id          String       @id
  topicId     String
  title       String
  subtitle    String
  order       Int
  topic       Topic        @relation(fields: [topicId], references: [id])
  articles    Article[]
  questions   Question[]
  recallCards RecallCard[]

  @@index([topicId])
}

model Article {
  id        String  @id
  chapterId String
  title     String
  kind      String
  level     Level?
  html      String
  /// Plain text of `html`, for search snippets.
  text      String  @default("")
  /// Lowercased title + text. Lowercased in JS, because Postgres lower()/ILIKE only
  /// folds ASCII under the C locale used by the dev cluster.
  search    String  @default("")
  order     Int
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  @@index([chapterId])
}

model Question {
  id           String   @id
  sectionId    String
  chapterId    String
  group        String
  level        Level
  text         String
  code         String
  options      String[]
  correctIndex Int
  explanation  String
  order        Int
  section      Section  @relation(fields: [sectionId], references: [id])
  chapter      Chapter  @relation(fields: [chapterId], references: [id])

  @@index([sectionId])
  @@index([chapterId])
}

model RecallCard {
  id        String  @id
  topicId   String
  chapterId String
  group     String
  question  String
  answer    String
  order     Int
  topic     Topic   @relation(fields: [topicId], references: [id])
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  @@index([topicId])
  @@index([chapterId])
}
